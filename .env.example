# ---------------------------------------------------------------------------
# Crucible — environment template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed. Do not paste secrets into chat or into any tracked file.
# ---------------------------------------------------------------------------

# --- Model providers -------------------------------------------------------

# Tier 1 (high volume, low stakes): recon, DOM/aria summarization, test
# generation, obvious classification.
#   CLEARANCE: PUBLIC data only. Free-tier prompts may be used for training.
#   Get a key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-latest
# Leave empty to disable tier 1 entirely (the router will fail closed).
ENABLE_GEMINI=true

# Tier 2 (low volume, high stakes): oracle verdicts, critic, debugger.
#   CLEARANCE: PUBLIC + PROPRIETARY.
#   Get a key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
ENABLE_NVIDIA=true

# Tier 3 (optional, local): zero-cost offline plumbing. Not installed yet.
#   CLEARANCE: PUBLIC + PROPRIETARY (nothing leaves the machine).
#   NOTE: never authorises verdicts. Plumbing/plumbing-only mode.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
ENABLE_OLLAMA=false

# --- Budgets ---------------------------------------------------------------
# Hard stops. Exceeding either raises BudgetExceeded and aborts the run.
MAX_RUN_COST_USD=2.00
MAX_RUN_TOKENS=2000000
# Per-provider request ceiling, to stay inside free-tier rate limits.
MAX_REQUESTS_PER_MINUTE=30

# --- Storage ---------------------------------------------------------------
CRUCIBLE_DB_URL=sqlite:///./crucible.db
CRUCIBLE_ARTIFACTS_DIR=./artifacts

# --- Safety ----------------------------------------------------------------
# The policy engine refuses irreversible actions unless the target is marked
# disposable. Never enable production targets without an explicit decision.
ALLOW_PRODUCTION_TARGETS=false
# Comma-separated egress allowlist for the browser agent. Empty = deny all
# non-target hosts.
EGRESS_ALLOWLIST=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Emit one JSON object per line (machine-readable) instead of human text.
LOG_JSON=false
